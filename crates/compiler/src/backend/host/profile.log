                              let l:scrollbar_chunk = a:state.scrollbar_chunk
                            
                              let l:before_thumb_chunks = repeat([[l:scrollbar_chunk]], l:thumb_start)
                              let l:thumb_chunks = repeat([[l:thumb_chunk]], l:thumb_size)
