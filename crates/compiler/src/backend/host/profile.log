                                        return -1
                                    elseif synname =~? '\(Comment\|Todo\)'
                                                \ && line !~# '^\s*/\*'  " not /* opening line
                                        if synname =~? "CommentML" " multi-line
                                            if line !~# '^\s*\*' && getline(a:lnum - 1) =~# '^\s*/\*'
