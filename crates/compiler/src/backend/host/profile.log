                                    for id in synstack(a:lnum, a:col)
                                        let synname = synIDattr(id, "name")
                                        if synname ==# "rustString" || synname =~# "^rustComment"
                                            return 1
                                        endif
                                    endfor
                                else
                                    " without syntax, let's not even try
                                    return 0
                                endif
                            endfunction
                            
