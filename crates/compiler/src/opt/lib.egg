(sort Stmt)
(sort StmtList)
(sort Expr)
(sort ExprList)
(sort ExprMap)
(sort Type)
(sort TypeList)
(sort TypeMap)

(function ExprListCons (Expr ExprList) ExprList)
(function ExprListNil () ExprList)
(function ExprMapCons (String Expr ExprMap) ExprMap)
(function ExprMapNil () ExprMap)

(function TypeListCons (Type TypeList) TypeList)
(function TypeListNil () TypeList)
(function TypeMapCons (String Type TypeMap) TypeMap)
(function TypeMapNil () TypeMap)

(function ExprInt (Type i64) Expr)
(function ExprFloat (Type f64) Expr)
(function ExprBool (Type bool) Expr)
(function ExprString (Type String) Expr)
(function ExprChar (Type String) Expr)
(function ExprTuple (Type ExprList) Expr)
(function ExprRecord (Type ExprMap) Expr)
(function ExprIndex (Type Expr i64) Expr)
(function ExprField (Type Expr String) Expr)
(function ExprVar (Type String) Expr)
; Includes both the egg name and the mangled name. For example:
; (ExprDef "add" "addi32" (TypeLambda
;   (TypeListCons (TypeCons "i32") (TypeListCons i32 TypeListNil))
(function ExprDef (Type String String) Expr)
(function ExprCall (Type Expr ExprList) Expr)
(function ExprIfElse (Type Expr Expr Expr) Expr)
(function ExprLetIn (Type String Expr Expr) Expr)

(function TypeCons (String TypeList) Type)
(function TypeLambda (TypeList Type) Type)
(function TypeTuple (TypeList) Type)
(function TypeRecord (TypeMap) Type)

(function StmtListCons (Stmt StmtList) StmtList)
(function StmtListNil () StmtList)
(function StmtDef (TypeMap Type String Expr) Stmt)

(include "typeof.egg")
(include "sugar.egg")
(include "free.egg")
