(function typeof (Expr) Type)

(rewrite (typeof (ExprInt t v)) t)
(rewrite (typeof (ExprFloat t v)) t)
(rewrite (typeof (ExprBool t v)) t)
(rewrite (typeof (ExprString t v)) t)
(rewrite (typeof (ExprChar t v)) t)
(rewrite (typeof (ExprTuple t es)) t)
(rewrite (typeof (ExprRecord t es)) t)
(rewrite (typeof (ExprIndex t e1 i)) t)
(rewrite (typeof (ExprField t e1 f)) t)
(rewrite (typeof (ExprVar t x)) t)
(rewrite (typeof (ExprDef t x m)) t)
(rewrite (typeof (ExprCall t e1 es)) t)
(rewrite (typeof (ExprIfElse t c e1 e2)) t)
(rewrite (typeof (ExprLetIn t x e1 e2)) t)
