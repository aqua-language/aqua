struct Data(time:Time, key:String, value:i32);

var i:Instance =
  from x in Stream[Data]::source(
    Reader::file(Path::new("data.csv"), false),
    Encoding::csv(','),
    (x, t) => x.time, 0s, 1s
  )
  where x.value < 50
  limit 100
  into sink(
    Writer::stdout(),
    Encoding::csv(',')
  ).run(Backend::native());
